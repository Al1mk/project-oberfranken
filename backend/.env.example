# Backend-only settings. Copy to backend/.env (git-ignored) and fill in locally. Never commit a real key,
# never put it in the UI or in a VITE_ variable, never paste it into chat.

OPENROUTER_API_KEY=sk-or-...

# Model sent in the request's "model" field.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Exact provider endpoint, REQUIRED (no default, no fallback). Must be one of the endpoints in
# APPROVED in src/oberfranken_rag/chat/settings.py for the model above (their prices bound the cost of a call), e.g. deepinfra/fp8.
# A model that is not listed there, for example a Pro variant, is refused: it has other prices.
OPENROUTER_PROVIDER_ENDPOINT=

# Paid calls stay off until you set this to 1 yourself, after the checks in backend/README.md.
OPENROUTER_ALLOW_PAID_CALLS=0

# Cumulative live-test budget in USD. The code never allows more than 1.00.
OPENROUTER_BUDGET_USD=1.00
